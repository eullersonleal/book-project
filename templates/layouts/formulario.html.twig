{% extends 'layouts/interno.html.twig' %}

{% block title %}{{ titulo_formulario }} | Book Project{% endblock %}

{% block conteudo %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <h1 class="h2 mb-4">{{ titulo_formulario }}</h1>

            <div class="card">
                <div class="card-body p-4">
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_widget(form) }}

                        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                Salvar
                            </button>
                            <a href="{{ path(rota_voltar) }}" class="btn btn-outline-secondary">
                                Voltar
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
