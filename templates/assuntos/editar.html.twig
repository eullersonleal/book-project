{% extends 'base.html.twig' %}

{% block title %}Editar assunto{% endblock %}

{% block body %}
    <h1>Editar assunto</h1>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.descricao) }}

        <button type="submit">Salvar alterações</button>
    {{ form_end(form) }}

    <p>
        <a href="{{ path('assuntos_index') }}">Voltar para assuntos</a>
    </p>
{% endblock %}