{% extends 'layouts/interno.html.twig' %}

{% block title %}Assuntos | Book Project{% endblock %}

{% block conteudo %}
    <div class="d-flex flex-column flex-md-row justify-content-between
                align-items-start align-items-md-center gap-3 mb-4">
        <h1 class="mb-0">Assuntos</h1>
        <a href="{{ path('assuntos_novo') }}" class="btn btn-primary">Novo assunto</a>
    </div>

    {% include 'components/mensagens.html.twig' %}

    <div class="table-responsive">
        <table class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Descrição</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for assunto in assuntos %}
                    <tr>
                        <th scope="row">{{ assunto.id }}</th>
                        <td>{{ assunto.descricao }}</td>
                        <td>
                            {% include 'components/acoes_registro.html.twig' with {
                                url_editar: path('assuntos_editar', {id: assunto.id}),
                                url_excluir: path('assuntos_excluir', {id: assunto.id}),
                                token_id: 'excluir_assunto_' ~ assunto.id,
                                nome_registro: assunto.descricao
                            } only %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-body-secondary py-4">
                            Nenhum assunto cadastrado.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
