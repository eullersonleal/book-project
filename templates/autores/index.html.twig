{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block body %}
    <h1>Autores</h1>
    
    <p>
        <a href="{{ path('autores_novo') }}">Novo autor</a>
    </p>

    {% for message in app.flashes('success') %}
        <p role="status">{{ message }}</p>
    {% endfor %}

    <table>
        <thead>
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nome</th>
            </tr>
        </thead>

        <tbody>
            {% for autor in autores %}
                <tr>
                    <td>{{ autor.id }}</td>
                    <td>{{ autor.nome }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Nenhum autor cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}