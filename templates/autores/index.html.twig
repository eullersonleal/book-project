{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block body %}
    <h1>Autores</h1>
    
    <p>
        <a href="{{ path('autores_novo') }}">Novo autor</a>
    </p>

    {% for message in app.flashes('success') %}
        <p role="status">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <p role="alert">{{ message }}</p>
    {% endfor %}

    <table>
        <thead>
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Nome</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>

        <tbody>
            {% for autor in autores %}
                <tr>
                    <td>{{ autor.id }}</td>
                    <td>{{ autor.nome }}</td>
                    <td>
                        <a href="{{ path('autores_editar', {id: autor.id}) }}">
                            Editar
                        </a>

                        <form
                            method="post"
                            action="{{ path('autores_excluir', {id: autor.id}) }}"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('excluir_autor_' ~ autor.id) }}"
                            >

                            <button type="submit">Excluir</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Nenhum autor cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}