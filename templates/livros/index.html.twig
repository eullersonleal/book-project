{% extends 'layouts/interno.html.twig' %}

{% block title %}Livros | Book Project{% endblock %}

{% block conteudo %}
    <div class="d-flex flex-column flex-md-row justify-content-between
                align-items-start align-items-md-center gap-3 mb-4">
        <h1 class="mb-0">Livros</h1>
        <a href="{{ path('livros_novo') }}" class="btn btn-primary">Novo livro</a>
    </div>

    {% include 'components/mensagens.html.twig' %}

    <div class="table-responsive">
        <table class="table table-hover align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Título</th>
                    <th scope="col">Autores</th>
                    <th scope="col">Assuntos</th>
                    <th scope="col" class="text-end">Valor</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for livro in livros %}
                    <tr>
                        <th scope="row">{{ livro.id }}</th>
                        <td>{{ livro.titulo }}</td>
                        <td>
                            {% for autor in livro.autores %}
                                {{ autor.nome }}{% if not loop.last %}, {% endif %}
                            {% else %}
                                <span class="text-body-secondary">Sem autor</span>
                            {% endfor %}
                        </td>
                        <td>
                            {% for assunto in livro.assuntos %}
                                {{ assunto.descricao }}{% if not loop.last %}, {% endif %}
                            {% else %}
                                <span class="text-body-secondary">Sem assunto</span>
                            {% endfor %}
                        </td>
                        <td class="text-end text-nowrap">
                            R$ {{ livro.valor|number_format(2, ',', '.') }}
                        </td>
                        <td>
                            {% include 'components/acoes_registro.html.twig' with {
                                url_editar: path('livros_editar', {id: livro.id}),
                                url_excluir: path('livros_excluir', {id: livro.id}),
                                token_id: 'excluir_livro_' ~ livro.id,
                                nome_registro: livro.titulo
                            } only %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-body-secondary py-4">
                            Nenhum livro cadastrado.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
