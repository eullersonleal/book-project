{% extends 'layouts/interno.html.twig' %}

{% block title %}Editar livro{% endblock %}

{% block body %}
    <h1>Editar livro</h1>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.descricao) }}

        <button type="submit">Salvar alterações</button>
    {{ form_end(form) }}

    <p>
        <a href="{{ path('livros_index') }}">Voltar para livros</a>
    </p>
{% endblock %}