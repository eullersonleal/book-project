{% extends 'layouts/portal.html.twig' %}

{% block title %}Book Project{% endblock %}

{% block introducao %}
    <p class="text-body-secondary mb-0">
        Gerencie livros, autores e assuntos.
    </p>
{% endblock %}

{% block conteudo_portal %}
    <div class="row g-3">
        <div class="col-12 col-md-6 d-flex">
            <a
                href="{{ path('documentacoes_index') }}"
                class="btn btn-outline-primary w-100 p-4
                       d-flex align-items-center justify-content-center"
            >
                <span class="fs-4 fw-semibold">Documentações</span>
            </a>
        </div>

        <div class="col-12 col-md-6 d-flex">
            <a
                href="{{ path('sistema_index') }}"
                class="btn btn-primary btn-acesso-sistema w-100 p-4
                       d-flex align-items-center justify-content-center"
            >
                <span class="fs-4 fw-semibold">Acessar o sistema</span>
            </a>
        </div>
    </div>
{% endblock %}