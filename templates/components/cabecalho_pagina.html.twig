<div class="d-flex flex-column flex-sm-row
            justify-content-between align-items-start
            gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">{{ titulo }}</h1>
        <p class="text-body-secondary mb-0">{{ descricao }}</p>
    </div>

    {% if url_acao is defined %}
        <a href="{{ url_acao }}" class="btn btn-primary">
            {{ texto_acao }}
        </a>
    {% endif %}
</div>