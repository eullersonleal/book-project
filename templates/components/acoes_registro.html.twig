<div class="d-flex justify-content-end gap-2">
    <a href="{{ url_editar }}" class="btn btn-outline-primary btn-sm"
       aria-label="Editar {{ nome_registro }}">
        Editar
    </a>

    <form method="post" action="{{ url_excluir }}" class="m-0">
        <input type="hidden" name="_token" value="{{ csrf_token(token_id) }}">
        <button type="submit" class="btn btn-outline-danger btn-sm"
                aria-label="Excluir {{ nome_registro }}">
            Excluir
        </button>
    </form>
</div>
